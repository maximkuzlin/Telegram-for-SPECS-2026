# ВСТАВИТЬ СЮДА. Эти два значения никогда не копировать в Lens Studio.
TELEGRAM_API_ID=PASTE_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=PASTE_TELEGRAM_API_HASH_HERE

# Для первого запуска на Mac оставьте так.
HOST=127.0.0.1
PORT=8787

# Папка TDLib с вашей Telegram-сессией. Не удаляйте её после login.
TDLIB_DATA_DIR=./data

# Для публичного сервера задайте длинную случайную строку.
BRIDGE_TOKEN=
